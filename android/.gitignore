# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# Trailing-suffix variants too: a "fetchy-release.jks.bak" does not match
# "*.jks", and a stray backup of a signing key is exactly as dangerous as
# the key itself.
key.properties.*
**/*.keystore.*
**/*.jks.*
